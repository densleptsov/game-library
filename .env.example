# Скопируй этот файл в .env и заполни своими значениями.
# .env НЕ коммитится в Git (см. .gitignore).

# Секретный ключ для подписи JWT. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Время жизни access-токена в минутах
ACCESS_TOKEN_EXPIRE_MINUTES=30

# URL базы данных
# Локально: SQLite-файл
# Прод: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./game_library.db